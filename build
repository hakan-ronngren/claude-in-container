#!/opt/homebrew/bin/bash

set -e

DOCKERFILE_DIR="$(dirname $0)"
IMAGE_NAME="claude-in-container"
TAG_FILE="$HOME/.config/claude-in-container/tag"

FORCE=false
for arg in "$@"; do
  [ "$arg" = "--force" ] && FORCE=true
done

CLAUDE_HOME_DIR="$HOME/.local/share/claude-in-container/home"
CLAUDE_MD="$CLAUDE_HOME_DIR/.claude/CLAUDE.md"

if $FORCE || [ ! -f "$CLAUDE_MD" ]; then
  mkdir -p "$(dirname "$CLAUDE_MD")"
  cat > "$CLAUDE_MD" <<'EOF'
# CLAUDE.md

You are running inside a container (a Kubernetes pod).

- You have your own home directory, separate from the user's. It is is `/home/claude`
  and persists across sessions.
- The user's project directory is mounted at `/home/claude/<project-name>` and is
  your working directory.
- You have passwordless sudo access on your container. Use `sudo apt install`
  to install any Debian packages you need. The user can approve this without risk,
  as you are modifying your container, not the user's computer.
- The user has a script `shell-in-claude-container` that lets them exec into your
  container to inspect or modify it.
- Host services are reachable at `host.docker.internal`. Do not use `localhost`
  to reach host services — it refers to the pod's own loopback, not the host.
EOF
  echo "${CLAUDE_MD} saved."
fi

if $FORCE || [ ! -f "$TAG_FILE" ] || [ "$DOCKERFILE_DIR/Dockerfile" -nt "$TAG_FILE" ]; then
  TAG=$(od -A n -t x1 -N 4 /dev/urandom | tr -d ' \n')
  if nerdctl info >/dev/null 2>&1; then
    nerdctl build --namespace k8s.io -t "$IMAGE_NAME:$TAG" "$DOCKERFILE_DIR"
  else
    docker build -t "$IMAGE_NAME:$TAG" "$DOCKERFILE_DIR"
  fi
  mkdir -p "$(dirname "$TAG_FILE")"
  printf '%s' "$TAG" > "$TAG_FILE"
else
  echo "${IMAGE_NAME}:$(cat $TAG_FILE) is up to date."
fi
