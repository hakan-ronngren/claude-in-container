#!/opt/homebrew/bin/bash

# claude-in-container - Start Claude Code in a Kubernetes pod
#
# Requires Homebrew bash (>= 4) — macOS /bin/bash is 3.2 and lacks `globstar`,
# which the .worktreeinclude seeding depends on. Install with `brew install bash`.

set -e

DOCKERFILE_DIR="$HOME/claude-in-container"
IMAGE_NAME="claude-in-container"
TAG_FILE="$HOME/.config/claude-in-container/tag"
CONFIG_DIR="$HOME/.config/claude-in-container"
EGRESS_FILE="$CONFIG_DIR/allowed-egresses.conf"
EGRESS_TEMPLATE="$DOCKERFILE_DIR/allowed-egresses.conf.template"
ENV_FILE="$CONFIG_DIR/env.conf"
MOUNTS_FILE="$CONFIG_DIR/mounts.conf"
CLAUDE_HOME_DIR="$HOME/.local/share/claude-in-container/home"

PROJECT_DIR="$(pwd)"

# Seed a freshly created clone (feature_dir) from the host working copy
# (repo_root) using .worktreeinclude, which uses .gitignore pattern syntax (the
# same file Claude Code's git worktrees support). Since the clone comes from
# 'origin', untracked local files (e.g. .env, caches, build output) and any
# uncommitted edits are absent otherwise — this is the worktree-equivalent copy
# step, except the container can never reach the host clone, so what isn't copied
# stays invisible to it. Supported .gitignore rules: a slashless pattern matches
# at any depth while a leading or embedded slash anchors to the repo root; a
# trailing slash matches directories only; a leading '!' negates, carving matches
# back out with last-match-wins precedence; a leading backslash escapes '#' or
# '!' and a trailing '\ ' keeps an otherwise-trimmed space; '*' matches within a
# path segment and '**' across segments (globstar needs bash >= 4); '#' comments
# and blank lines are ignored.
seed_worktree_include() {
    local repo_root="$1" feature_dir="$2"
    local worktree_include="$repo_root/.worktreeinclude"
    [ -f "$worktree_include" ] || return 0
    (
        cd "$repo_root"
        shopt -s globstar dotglob nullglob
        # IFS='' keeps a pattern that contains a literal space as a single glob
        # word; nothing below relies on word splitting ('read' sets its own IFS).
        IFS=''
        local -A selected=()
        local pattern stripped match negate anchored dir_only
        while IFS= read -r pattern || [ -n "$pattern" ]; do
            pattern="${pattern%$'\r'}"                        # strip CR (CRLF files)
            pattern="${pattern#"${pattern%%[![:space:]]*}"}"  # trim leading whitespace
            # Trim trailing whitespace, but keep a backslash-escaped trailing space.
            stripped="${pattern%"${pattern##*[![:space:]]}"}"
            if [[ "$stripped" =~ (\\+)$ ]] && (( ${#BASH_REMATCH[1]} % 2 == 1 )); then
                pattern="${stripped%\\} "                     # '\<space>' keeps one space
            else
                pattern="$stripped"
            fi
            [ -z "$pattern" ] && continue
            # Comment / negation, honoring a leading backslash escape of '#' or '!'.
            negate=false
            case "$pattern" in
                '#'*)  continue ;;                            # comment line
                '!'*)  negate=true; pattern="${pattern#!}" ;; # negation: carve matches out
                '\#'* | '\!'*) pattern="${pattern#\\}" ;;     # escaped: literal '#' / '!'
            esac
            # gitignore anchoring: a slash anywhere but a trailing one anchors the
            # pattern to the repo root; a slashless pattern matches at any depth.
            anchored=false dir_only=false
            if [ "${pattern:0:1}" = "/" ]; then
                anchored=true
                pattern="${pattern#/}"
            fi
            if [ "${pattern: -1}" = "/" ]; then
                dir_only=true                                 # trailing slash: directories only
                pattern="${pattern%/}"
            fi
            [ -z "$pattern" ] && continue
            case "$pattern" in */*) anchored=true ;; esac
            $anchored || pattern="**/$pattern"
            for match in $pattern; do
                if [ ! -e "$match" ] || [ "$match" = ".git" ]; then
                    continue
                fi
                case "$match" in .git/*) continue ;; esac
                if $dir_only && [ ! -d "$match" ]; then
                    continue                                  # trailing-slash pattern skips files
                fi
                if $negate; then
                    unset "selected[$match]"                  # last match wins
                else
                    selected["$match"]=1
                fi
            done
        done < .worktreeinclude
        if [ ${#selected[@]} -gt 0 ]; then
            # tar preserves the relative paths, file modes and modification
            # times (like 'cp -p') as it merges into the clone, overwriting
            # tracked files and never nesting directories. Keep the mtime
            # guarantee if this is ever rewritten: a plain 'cp' would reset
            # dates, so use 'cp -p' / 'cp --preserve' instead.
            tar -cf - "${!selected[@]}" | tar -C "$feature_dir" -xpf -
            printf 'Applied .worktreeinclude: copied %d path(s) into the clone\n' "${#selected[@]}"
        fi
    )
}

# Internal hook for the test suite: run only the seeding step and exit. Keeps the
# behavior testable without standing up a Kubernetes cluster.
if [ "${1:-}" = "--cic-internal-seed" ]; then
    seed_worktree_include "$2" "$3"
    exit 0
fi

# Parse our own flags before forwarding the rest to claude
INSECURE=false
CIC_FEATURE=""
CLAUDE_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --cic-insecure)
            INSECURE=true
            ;;
        --cic-feature)
            if [ -z "${2:-}" ]; then
                echo "ERROR: --cic-feature requires a NAME argument." >&2
                exit 1
            fi
            CIC_FEATURE="$2"
            # Validate feature name: no slashes or asterisks (used in path construction)
            if [[ "$CIC_FEATURE" =~ [/*] ]]; then
                echo "ERROR: feature name cannot contain slashes or asterisks." >&2
                exit 1
            fi
            shift
            ;;
        *)
            CLAUDE_ARGS+=("$1")
            ;;
    esac
    shift
done

if $INSECURE; then
    NAMESPACE="claude-insecure"
else
    NAMESPACE="claude"
fi

# With --cic-feature <NAME>, work in a dedicated clone of the current repo's
# 'origin' instead of the current directory. The clone lives at
# <repo-root>/.claude/cic-features/<NAME> and persists across sessions, so the
# same feature can be re-entered later by passing the same NAME.
if [ -n "$CIC_FEATURE" ]; then
    if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || [ -z "$REPO_ROOT" ]; then
        echo "ERROR: --cic-feature must be run from inside a git clone." >&2
        exit 1
    fi
    if ! ORIGIN_URL="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null)" || [ -z "$ORIGIN_URL" ]; then
        echo "ERROR: repository at '$REPO_ROOT' has no 'origin' remote to clone from." >&2
        exit 1
    fi

    # Ensure .claude/cic-features directory exists in the repo root
    mkdir -p "$REPO_ROOT/.claude/cic-features"

    # Ensure .claude/cic-features is in .git/info/exclude
    EXCLUDE_FILE="$REPO_ROOT/.git/info/exclude"
    if ! grep -qx '\.claude/cic-features' "$EXCLUDE_FILE" 2>/dev/null; then
        echo ".claude/cic-features" >> "$EXCLUDE_FILE"
    fi

    FEATURE_DIR="$REPO_ROOT/.claude/cic-features/$CIC_FEATURE"
    if [ -d "$FEATURE_DIR" ]; then
        echo "Reusing existing feature clone at $FEATURE_DIR"
        # Switch to or create the branch matching the feature name
        if git -C "$FEATURE_DIR" rev-parse --verify "$CIC_FEATURE" >/dev/null 2>&1; then
            echo "Switching to existing branch '$CIC_FEATURE'"
            git -C "$FEATURE_DIR" checkout "$CIC_FEATURE"
        else
            echo "Creating new branch '$CIC_FEATURE'"
            git -C "$FEATURE_DIR" checkout -b "$CIC_FEATURE"
        fi
    else
        echo "Creating feature clone '$CIC_FEATURE' at $FEATURE_DIR ..."
        git clone "$ORIGIN_URL" "$FEATURE_DIR"

        # Create and switch to the feature branch
        echo "Creating new branch '$CIC_FEATURE'"
        git -C "$FEATURE_DIR" checkout -b "$CIC_FEATURE"

        seed_worktree_include "$REPO_ROOT" "$FEATURE_DIR"
    fi
    PROJECT_DIR="$FEATURE_DIR"

    # Name the claude session after the feature so multiple concurrent sessions
    # are easy to tell apart, unless the caller already passed their own --name.
    has_name=false
    for arg in "${CLAUDE_ARGS[@]}"; do
        if [ "$arg" = "--name" ]; then
            has_name=true
            break
        fi
    done
    if ! $has_name; then
        CLAUDE_ARGS+=(--name "$CIC_FEATURE")
    fi
fi

# Check that the image has been built
if [ ! -f "$TAG_FILE" ]; then
    echo "No image tag found. Run 'build' inside the claude-in-container repo clone first." >&2
    exit 1
fi
IMAGE_TAG=$(cat "$TAG_FILE")

KUBECTL="kubectl --context rancher-desktop"

GIT_AUTHOR_EMAIL="$(git config user.email)"
GIT_AUTHOR_NAME="$(git config user.name)"

POD_SUFFIX=$(od -A n -t x1 -N 4 /dev/urandom | tr -d ' \n')
POD_NAME="claude-$POD_SUFFIX"

mkdir -p "$CLAUDE_HOME_DIR/projects"

if ! $INSECURE; then
    # Verify Istio is installed
    if ! $KUBECTL get pods -n istio-system -l app=istiod --no-headers 2>/dev/null | grep -q Running; then
        echo "ERROR: Istio is not installed or not running in istio-system." >&2
        echo "       Install it first:" >&2
        echo "         curl -L https://istio.io/downloadIstio | sh -" >&2
        echo "         istioctl install --set profile=minimal \\" >&2
        echo "                          --set meshConfig.outboundTrafficPolicy.mode=REGISTRY_ONLY \\" >&2
        echo "                          --set meshConfig.accessLogFile=/dev/stdout -y" >&2
        echo "" >&2
        echo "       Or start an unrestricted session with: claude-in-container --cic-insecure" >&2
        exit 1
    fi

    # Ensure mesh is configured for REGISTRY_ONLY egress and access logging
    MESH_CONFIG=$($KUBECTL get configmap istio -n istio-system -o jsonpath='{.data.mesh}' 2>/dev/null)
    REGISTRY_ONLY=$(echo "$MESH_CONFIG" | grep -c "REGISTRY_ONLY" || true)
    ACCESS_LOG=$(echo "$MESH_CONFIG" | grep -c "accessLogFile" || true)
    if [ "$REGISTRY_ONLY" -eq 0 ] || [ "$ACCESS_LOG" -eq 0 ]; then
        echo "Configuring Istio mesh settings (REGISTRY_ONLY + access logging)..."
        istioctl install --set profile=minimal \
                         --set meshConfig.outboundTrafficPolicy.mode=REGISTRY_ONLY \
                         --set meshConfig.accessLogFile=/dev/stdout -y
    fi

    # Create allowlist from template if it doesn't exist yet
    if [ ! -f "$EGRESS_FILE" ]; then
        mkdir -p "$CONFIG_DIR"
        cp "$EGRESS_TEMPLATE" "$EGRESS_FILE"
        echo "Created $EGRESS_FILE from template — edit it to customise your allowlist."
    fi

    # Exclude host.docker.internal from Istio interception so host services remain reachable
    HOST_DOCKER_IP=$(rdctl shell -- getent hosts host.docker.internal 2>/dev/null | awk '{print $1}')
    EXCLUDE_RANGES="${HOST_DOCKER_IP:+${HOST_DOCKER_IP}/32}"

    # Generate and apply Istio manifests from the allowlist
    update-claude-container-egress
else
    EXCLUDE_RANGES=""
fi

EXTRA_ENV=""
if [ -f "$ENV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        KEY="${line%%=*}"
        VALUE="${line#*=}"
        EXTRA_ENV+="        - name: $KEY"$'\n'"          value: \"$VALUE\""$'\n'
    done < "$ENV_FILE"
fi

EXTRA_VOLUME_MOUNTS=""
EXTRA_VOLUMES=""
MOUNT_IDX=0
if [ -f "$MOUNTS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        HOST_PATH="${line%%:*}"
        CONTAINER_PATH="${line#*:}"
        HOST_PATH="${HOST_PATH/#\~/$HOME}"
        if [ -d "$HOST_PATH" ]; then
            PATH_TYPE="Directory"
        elif [ -f "$HOST_PATH" ]; then
            PATH_TYPE="File"
        else
            echo "Mount source does not exist: $HOST_PATH" >&2
            exit 1
        fi
        VOL_NAME="extra-$MOUNT_IDX"
        EXTRA_VOLUME_MOUNTS+="        - name: $VOL_NAME"$'\n'"          mountPath: $CONTAINER_PATH"$'\n'
        EXTRA_VOLUMES+="    - name: $VOL_NAME"$'\n'"      hostPath:"$'\n'"        path: $HOST_PATH"$'\n'"        type: $PATH_TYPE"$'\n'
        MOUNT_IDX=$((MOUNT_IDX + 1))
    done < "$MOUNTS_FILE"
fi

# Mount the host's Application Default Credentials read-only so in-container
# Vertex AI / Genkit flows can authenticate without needing gcloud installed.
# The host file (written by `gcloud auth` / `npm run gcp:login`) carries an
# OAuth refresh token, so mount only this single file and always read-only.
# It nests inside the claude-home volume; kubelet mounts the parent first and
# creates the target, so the nested hostPath mount resolves correctly.
ADC_HOST_FILE="$HOME/.config/gcloud/application_default_credentials.json"
ADC_CONTAINER_FILE="/home/claude/.config/gcloud/application_default_credentials.json"
if [ -f "$ADC_HOST_FILE" ]; then
    EXTRA_VOLUME_MOUNTS+="        - name: gcloud-adc"$'\n'"          mountPath: $ADC_CONTAINER_FILE"$'\n'"          readOnly: true"$'\n'
    EXTRA_VOLUMES+="    - name: gcloud-adc"$'\n'"      hostPath:"$'\n'"        path: $ADC_HOST_FILE"$'\n'"        type: File"$'\n'
    printf '\033[2mMounting gcloud application default credentials (read-only) for Vertex AI.\033[0m\n'
fi

trap "${KUBECTL} delete pod $POD_NAME -n $NAMESPACE --ignore-not-found --grace-period=2 >/dev/null 2>&1" EXIT

# For --cic-insecure, create the namespace if it doesn't exist.
# For the default (secure) path, update-claude-container-egress already applied
# the namespace with the istio-injection: enabled label; applying it again here
# without that label would strip it and disable sidecar injection.
if $INSECURE; then
    ${KUBECTL} apply -f - >/dev/null <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: $NAMESPACE
EOF
fi

${KUBECTL} apply -f - >/dev/null <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $POD_NAME
  namespace: $NAMESPACE
  ${EXCLUDE_RANGES:+annotations:}
  ${EXCLUDE_RANGES:+  traffic.sidecar.istio.io/excludeOutboundIPRanges: "${EXCLUDE_RANGES}"}
spec:
  hostNetwork: false
  restartPolicy: Never
  containers:
    - name: claude
      image: $IMAGE_NAME:$IMAGE_TAG
      imagePullPolicy: Never
      workingDir: $PROJECT_DIR
      command: ["sleep", "infinity"]
      env:
        - name: HOME
          value: /home/claude
        - name: TERM
          value: "$TERM"
        - name: COLORTERM
          value: "$COLORTERM"
        - name: TEST_HOST
          value: host.docker.internal
        - name: GIT_AUTHOR_EMAIL
          value: "$GIT_AUTHOR_EMAIL"
        - name: GIT_AUTHOR_NAME
          value: "$GIT_AUTHOR_NAME"
        - name: GIT_COMMITTER_EMAIL
          value: "$GIT_AUTHOR_EMAIL"
        - name: GIT_COMMITTER_NAME
          value: "$GIT_AUTHOR_NAME"
${EXTRA_ENV}
      volumeMounts:
        - name: claude-home
          mountPath: /home/claude
        - name: project
          mountPath: $PROJECT_DIR
${EXTRA_VOLUME_MOUNTS}
  volumes:
    - name: claude-home
      hostPath:
        path: $CLAUDE_HOME_DIR
        type: DirectoryOrCreate
    - name: project
      hostPath:
        path: $PROJECT_DIR
        type: Directory
${EXTRA_VOLUMES}
EOF

printf '\033[2mCreating pod...\033[0m\n'
${KUBECTL} wait --for=condition=Ready pod/"$POD_NAME" -n "$NAMESPACE" --timeout=60s >/dev/null

if $INSECURE; then
    printf '\033[33m⚠ Outgoing network traffic unrestricted.\033[0m\n'
else
    printf '\033[33mNetwork traffic control active — see https://github.com/hakan-ronngren/claude-in-container/blob/main/README.md on how to detect and allowlist blocked traffic.\033[0m\n'
fi

CLAUDE_BIN=/home/claude/.local/bin/claude

if ! ${KUBECTL} exec "$POD_NAME" -n "$NAMESPACE" -- test -f "$CLAUDE_BIN" 2>/dev/null; then
    printf '\033[2mInstalling Claude Code...\033[0m\n'
    ${KUBECTL} exec "$POD_NAME" -n "$NAMESPACE" -- bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
fi

${KUBECTL} exec -it "$POD_NAME" -n "$NAMESPACE" -- "$CLAUDE_BIN" "${CLAUDE_ARGS[@]}"
exit_code=$?

if [ $exit_code -eq 0 ]; then
    command=$(basename $0)
    if [ "$command" != 'claude' ]; then
        if [ -n "$CIC_FEATURE" ]; then
            # Ask whether to keep or delete the feature clone
            printf "\033[1;33mKeep the feature clone at $FEATURE_DIR? [Y/n]: \033[0m"
            read -r KEEP_CLONE
            KEEP_CLONE="${KEEP_CLONE:-Y}"  # Default to 'Y' if user just presses Enter
            if [[ "$KEEP_CLONE" =~ ^[Yy] ]]; then
                printf "\033[1;35mContainer sessions are kept separate, so to resume this session, use:\033[0m\n"
                printf "\033[1;35m  $command --cic-feature $CIC_FEATURE --resume <session-id>\033[0m\n"
            else
                printf "\033[2mDeleting feature clone at $FEATURE_DIR...\033[0m\n"
                rm -rf "$FEATURE_DIR"
                printf "\033[1;35mFeature clone deleted. This session cannot be resumed.\033[0m\n"
            fi
        else
            printf "\033[1;35mContainer sessions are kept separate, so to resume this session, use:\033[0m\n"
            printf "\033[1;35m  $command --resume <session-id>\033[0m\n"
        fi
    fi
    printf '\033[2mRemoving pod...\033[0m\n'
fi

${KUBECTL} delete pod $POD_NAME -n $NAMESPACE --ignore-not-found --grace-period=2 >/dev/null 2>&1

exit $exit_code
