#!/bin/bash

# claude-in-container - Start Claude Code in a Kubernetes pod

set -e

DOCKERFILE_DIR="$HOME/claude-in-container"
IMAGE_NAME="claude-in-container"
NAMESPACE="claude"
TAG_FILE="$HOME/.config/claude-in-container/tag"
CONFIG_DIR="$HOME/.config/claude-in-container"
EGRESS_FILE="$CONFIG_DIR/allowed-egresses.conf"
MANIFESTS_DIR="$CONFIG_DIR/manifests"
CLAUDE_HOME_DIR="$HOME/.local/share/claude-in-container/home"

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# Check that the image has been built
if [ ! -f "$TAG_FILE" ]; then
    echo "No image tag found. Run 'build' inside the claude-in-container repo clone first." >&2
    exit 1
fi
IMAGE_TAG=$(cat "$TAG_FILE")

kubectl config use-context rancher-desktop

GIT_AUTHOR_EMAIL="$(git config user.email)"
GIT_AUTHOR_NAME="$(git config user.name)"

POD_SUFFIX=$(od -A n -t x1 -N 4 /dev/urandom | tr -d ' \n')
POD_NAME="claude-$POD_SUFFIX"

mkdir -p "$CLAUDE_HOME_DIR/projects"

# Enable egress control when allowed-egresses.conf exists (written by setup-network-security).
# With Istio sidecar injection, hostNetwork must be false.
if [ -f "$EGRESS_FILE" ]; then
    HOST_NETWORK="false"
    # Exclude host.docker.internal from Istio interception so host services remain reachable.
    # The annotation bypasses iptables rules for that IP — no port enumeration needed.
    HOST_DOCKER_IP=$(rdctl shell -- getent hosts host.docker.internal 2>/dev/null | awk '{print $1}')
    EXCLUDE_RANGES="${HOST_DOCKER_IP:+${HOST_DOCKER_IP}/32}"

    # Generate Istio manifests from allowed-egresses.conf
    mkdir -p "$MANIFESTS_DIR"

    cat > "$MANIFESTS_DIR/istio-namespace.yaml" <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: $NAMESPACE
  labels:
    istio-injection: enabled
EOF

    # Build sidecar host list and service entries from the egress file.
    # Wildcards use resolution: NONE (Istio can't DNS-resolve them);
    # exact names use resolution: DNS.
    SIDECAR_HOSTS="    - istio-system/*"
    DNS_HOSTS=""
    WILDCARD_HOSTS=""
    while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        SIDECAR_HOSTS+=$'\n'"    - ./$line"
        if [[ "$line" == \** ]]; then
            WILDCARD_HOSTS+=$'\n'"  - \"$line\""
        else
            DNS_HOSTS+=$'\n'"  - $line"
        fi
    done < "$EGRESS_FILE"

    cat > "$MANIFESTS_DIR/istio-sidecar.yaml" <<EOF
apiVersion: networking.istio.io/v1beta1
kind: Sidecar
metadata:
  name: default
  namespace: $NAMESPACE
spec:
  egress:
  - hosts:
$SIDECAR_HOSTS
EOF

    {
        if [ -n "$DNS_HOSTS" ]; then
            cat <<EOF
apiVersion: networking.istio.io/v1beta1
kind: ServiceEntry
metadata:
  name: allow-exact-hosts
  namespace: $NAMESPACE
spec:
  hosts:
$DNS_HOSTS
  ports:
  - number: 443
    name: https
    protocol: HTTPS
  resolution: DNS
  location: MESH_EXTERNAL
EOF
        fi
        if [ -n "$WILDCARD_HOSTS" ]; then
            [ -n "$DNS_HOSTS" ] && echo "---"
            cat <<EOF
apiVersion: networking.istio.io/v1beta1
kind: ServiceEntry
metadata:
  name: allow-wildcard-hosts
  namespace: $NAMESPACE
spec:
  hosts:
$WILDCARD_HOSTS
  ports:
  - number: 443
    name: https
    protocol: HTTPS
  resolution: NONE
  location: MESH_EXTERNAL
EOF
        fi
    } > "$MANIFESTS_DIR/istio-service-entries.yaml"
else
    HOST_NETWORK="true"
    EXCLUDE_RANGES=""
fi

trap "kubectl delete pod $POD_NAME -n $NAMESPACE --ignore-not-found --grace-period=2 >/dev/null 2>&1" EXIT

# Create namespace first so manifests can reference it
kubectl apply -f - <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: $NAMESPACE
EOF

# Apply generated egress-control manifests
if [ "$HOST_NETWORK" = "false" ]; then
    kubectl apply -f "$MANIFESTS_DIR"
fi

kubectl apply -f - <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $POD_NAME
  namespace: $NAMESPACE
  ${EXCLUDE_RANGES:+annotations:}
  ${EXCLUDE_RANGES:+  traffic.sidecar.istio.io/excludeOutboundIPRanges: "${EXCLUDE_RANGES}"}
spec:
  hostNetwork: $HOST_NETWORK
  restartPolicy: Never
  containers:
    - name: claude
      image: $IMAGE_NAME:$IMAGE_TAG
      imagePullPolicy: Never
      workingDir: /home/claude/projects/$PROJECT_NAME
      command: ["sleep", "infinity"]
      env:
        - name: HOME
          value: /home/claude
        - name: TERM
          value: "$TERM"
        - name: COLORTERM
          value: "$COLORTERM"
        - name: TEST_HOST
          value: host.docker.internal
        - name: GIT_AUTHOR_EMAIL
          value: "$GIT_AUTHOR_EMAIL"
        - name: GIT_AUTHOR_NAME
          value: "$GIT_AUTHOR_NAME"
        - name: GIT_COMMITTER_EMAIL
          value: "$GIT_AUTHOR_EMAIL"
        - name: GIT_COMMITTER_NAME
          value: "$GIT_AUTHOR_NAME"
      volumeMounts:
        - name: claude-home
          mountPath: /home/claude
        - name: project
          mountPath: /home/claude/projects/$PROJECT_NAME
  volumes:
    - name: claude-home
      hostPath:
        path: $CLAUDE_HOME_DIR
        type: DirectoryOrCreate
    - name: project
      hostPath:
        path: $PROJECT_DIR
        type: Directory
EOF

kubectl wait --for=condition=Ready pod/"$POD_NAME" -n "$NAMESPACE" --timeout=60s

[ "$HOST_NETWORK" = "false" ] && printf '\033[33mEgress control active — see README to detect and allowlist blocked traffic.\033[0m\n'

kubectl exec -it "$POD_NAME" -n "$NAMESPACE" -- claude "$@"
exit_code=$?

if [ $exit_code -eq 0 ]; then
    command=$(basename $0)
    if [ "$command" != 'claude' ]; then
        printf "\033[1;35mContainer sessions are kept separate, so to resume this session, use:\033[0m\n"
        printf "\033[1;35m  $command --resume <session-id>\033[0m\n"
    fi
    printf '\033[2mRemoving pod...\033[0m\n'
fi

kubectl delete pod $POD_NAME -n $NAMESPACE --ignore-not-found --grace-period=2 >/dev/null 2>&1

exit $exit_code
