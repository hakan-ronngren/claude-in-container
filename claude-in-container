#!/bin/bash

# claude-in-container - Start Claude Code in a Kubernetes pod

set -e

DOCKERFILE_DIR="$HOME/claude-in-container"
IMAGE_NAME="claude-in-container"
NAMESPACE="claude"
TAG_FILE="$HOME/.config/claude-in-container/tag"
CLAUDE_HOME_DIR="$HOME/.local/share/claude-in-container/home"

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# Check that the image has been built
if [ ! -f "$TAG_FILE" ]; then
    echo "No image tag found. Run 'build' inside the claude-in-container repo clone first." >&2
    exit 1
fi
IMAGE_TAG=$(cat "$TAG_FILE")

kubectl config use-context rancher-desktop

GIT_AUTHOR_EMAIL="$(git config user.email)"
GIT_AUTHOR_NAME="$(git config user.name)"

POD_SUFFIX=$(od -A n -t x1 -N 4 /dev/urandom | tr -d ' \n')
POD_NAME="claude-$POD_SUFFIX"

mkdir -p "$CLAUDE_HOME_DIR"

trap "printf '\033[2mRemoving pod...\033[0m\n'; kubectl delete pod $POD_NAME -n $NAMESPACE --ignore-not-found --grace-period=2 >/dev/null 2>&1" EXIT

kubectl apply -f - <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: $NAMESPACE
---
apiVersion: v1
kind: Pod
metadata:
  name: $POD_NAME
  namespace: $NAMESPACE
spec:
  hostNetwork: true
  restartPolicy: Never
  containers:
    - name: claude
      image: $IMAGE_NAME:$IMAGE_TAG
      imagePullPolicy: Never
      workingDir: /home/me/$PROJECT_NAME
      command: ["sleep", "infinity"]
      env:
        - name: HOME
          value: /home/me
        - name: TERM
          value: "$TERM"
        - name: COLORTERM
          value: "$COLORTERM"
        - name: TEST_HOST
          value: host.docker.internal
        - name: GIT_AUTHOR_EMAIL
          value: "$GIT_AUTHOR_EMAIL"
        - name: GIT_AUTHOR_NAME
          value: "$GIT_AUTHOR_NAME"
        - name: GIT_COMMITTER_EMAIL
          value: "$GIT_AUTHOR_EMAIL"
        - name: GIT_COMMITTER_NAME
          value: "$GIT_AUTHOR_NAME"
      volumeMounts:
        - name: claude-home
          mountPath: /home/me
        - name: project
          mountPath: /home/me/$PROJECT_NAME
  volumes:
    - name: claude-home
      hostPath:
        path: $CLAUDE_HOME_DIR
        type: DirectoryOrCreate
    - name: project
      hostPath:
        path: $PROJECT_DIR
        type: Directory
EOF

kubectl wait --for=condition=Ready pod/"$POD_NAME" -n "$NAMESPACE" --timeout=60s

kubectl exec -it "$POD_NAME" -n "$NAMESPACE" -- claude "$@"
