#!/bin/bash

# shell-in-claude-container - Start a shell in an existing Claude Code container

set -e

kubectl config use-context rancher-desktop >/dev/null

NAMESPACES=("claude" "claude-insecure")

PODS=()
POD_NAMESPACES=()
for ns in "${NAMESPACES[@]}"; do
    while IFS= read -r pod; do
        if [ -n "$pod" ]; then
            PODS+=("$pod")
            POD_NAMESPACES+=("$ns")
        fi
    done < <(kubectl get pods -n "$ns" --field-selector=status.phase=Running -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)
done

if [ ${#PODS[@]} -eq 0 ]; then
    echo "No running Claude pod found in namespaces: ${NAMESPACES[*]}." >&2
    exit 1
fi

LABELS=()
for i in "${!PODS[@]}"; do
    pod="${PODS[$i]}"
    ns="${POD_NAMESPACES[$i]}"
    project=$(kubectl get pod "$pod" -n "$ns" -o jsonpath='{.spec.containers[0].workingDir}')
    LABELS+=("[$ns] $pod  ($project)")
done

if [ ${#PODS[@]} -eq 1 ]; then
    IDX=0
else
    PS3="Choose a pod: "
    select label in "${LABELS[@]}"; do
        [ -n "$label" ] && IDX=$((REPLY-1)) && break
        echo "Invalid choice." >&2
    done
fi

POD_NAME="${PODS[$IDX]}"
NS="${POD_NAMESPACES[$IDX]}"

echo "Attaching to $POD_NAME ($NS)..."
kubectl exec -it "$POD_NAME" -n "$NS" -- /bin/bash
